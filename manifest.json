{
  "manifest_version": 3,
  "name": "Phishing Tjek",
  "version": "1.9.1",
  "description": "Tjek om et link ser mistænkeligt ud",
  "homepage_url": "https://vindfoxy-alt.github.io/link-check/",
  "permissions": ["tabs", "webNavigation", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "indstillinger.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["checks.js", "fremhaev.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["checks.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "phishing-tjek@vindfoxy-alt.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["browsingActivity"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
